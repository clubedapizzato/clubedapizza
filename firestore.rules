rules_version = '2';
// Regras do Firestore — cole em: Firebase Console → Firestore → Regras
service cloud.firestore {
  match /databases/{database}/documents {

    // Contador diário do número do pedido (#1, #2, ...)
    match /contadores/{dia} {
      allow read: if true;
      allow create: if request.resource.data.n == 1;
      allow update: if request.resource.data.n == resource.data.n + 1;
    }

    match /pedidos/{id} {
      // Cliente acompanha o próprio pedido pelo link (id impossível de adivinhar).
      allow get: if true;
      // Só a cozinha / balcão / relatórios (usuário logado) listam pedidos.
      allow list: if request.auth != null;

      // Pedido do SITE: qualquer cliente cria, sempre "novo", não impresso e com pagamento NÃO confirmado.
      // Pedido do BALCÃO: só usuário logado (atendente). Comer aqui/levar (tipo 'balcao') ou
      // delivery por WhatsApp/telefone (tipo 'entrega'), pago, a cobrar na entrega ou fiado.
      // Balcão sem pizza (só bebidas/produtos) já nasce "entregue" (não passa pela cozinha).
      allow create: if (request.resource.data.status == 'novo'
                        || (request.auth != null
                            && request.resource.data.origem == 'balcao'
                            && request.resource.data.status == 'entregue'))
                    && request.resource.data.impresso == false
                    && request.resource.data.itens is list
                    && request.resource.data.itens.size() > 0
                    && request.resource.data.itens.size() <= 50
                    && request.resource.data.cliente.nome is string
                    && request.resource.data.total is number
                    && (request.resource.data.get('agendadoPara', null) == null
                        || request.resource.data.agendadoPara is number)
                    && ((request.resource.data.origem == 'site'
                         && request.resource.data.get('estoqueBaixado', false) == false
                         && request.resource.data.pagamento.confirmado == false
                         && request.resource.data.cliente.telefone is string)
                     || (request.auth != null
                         && request.resource.data.origem == 'balcao'
                         && request.resource.data.entrega.tipo in ['balcao', 'entrega']
                         && request.resource.data.pagamento.confirmado is bool));

      // Mudar status / confirmar Pix / marcar impresso / entregador: só usuário logado.
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Código de acompanhamento (ex.: K7P3QX) → id do pedido. O cliente abre pelo código,
    // mas não lista; só é criado junto com o pedido (na mesma transação) e nunca alterado.
    match /rastreio/{codigo} {
      allow get: if true;
      allow list: if false;
      allow create: if codigo.matches('^[2-9A-HJKMNP-Z]{6}$')
                    && request.resource.data.keys().hasOnly(['pedidoId', 'criadoEm'])
                    && request.resource.data.pedidoId is string
                    && existsAfter(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId));
      allow update, delete: if false;
    }

    // Catálogo (preços, ativo, estoque disponível): a loja lê; só a gestão (logado) altera.
    match /produtos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuração da loja (cortesia de sachês, maquininha, tempos da previsão) e
    // config/fila (fila do dia SEM dados pessoais, publicada pela cozinha): leitura pública.
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ficha técnica: insumos (preço de compra) e fichas (custo de cada sabor/adicional). Custos são PRIVADOS: só logado.
    match /insumos/{id} {
      allow read, write: if request.auth != null;
    }
    match /fichas/{id} {
      allow read, write: if request.auth != null;
    }

    // Entradas de compra, ajustes, baixas de venda e estornos: só logado.
    match /movimentos/{id} {
      allow read, write: if request.auth != null;
    }

    // Fidelidade (controle interno da página Clientes): regra (fidelidade/config) e
    // recompensas entregues por telefone (fidelidade/{telefone}). PRIVADO: só logado.
    match /fidelidade/{id} {
      allow read, write: if request.auth != null;
    }

    // Financeiro / Caixa (caixa.html): lançamentos, contas a pagar/receber, fiados, funcionários,
    // folha, turnos de caixa e configuração. PRIVADO: só logado.
    match /fin_lancamentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /fin_contas/{id} {
      allow read, write: if request.auth != null;
    }
    match /fin_fiados/{id} {
      allow read, write: if request.auth != null;
    }
    match /fin_funcionarios/{id} {
      allow read, write: if request.auth != null;
    }
    match /fin_folha/{id} {
      allow read, write: if request.auth != null;
    }
    match /fin_caixas/{id} {
      allow read, write: if request.auth != null;
    }
    match /fin_config/{id} {
      allow read, write: if request.auth != null;
    }
  }
}

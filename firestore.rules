rules_version = '2';
// Regras do Firestore — cole em: Firebase Console → Firestore → Regras
service cloud.firestore {
  match /databases/{database}/documents {

    // Contador diário do número do pedido (#1, #2, ...)
    match /contadores/{dia} {
      allow read: if true;
      allow create: if request.resource.data.n == 1;
      allow update: if request.resource.data.n == resource.data.n + 1;
    }

    match /pedidos/{id} {
      // Cliente acompanha o próprio pedido pelo link (id impossível de adivinhar).
      allow get: if true;
      // Só a cozinha / balcão / relatórios (usuário logado) listam pedidos.
      allow list: if request.auth != null;

      // Pedido do SITE: qualquer cliente cria, sempre "novo", não impresso e com pagamento NÃO confirmado.
      // Pedido do BALCÃO: só usuário logado (atendente), já pago.
      allow create: if request.resource.data.status == 'novo'
                    && request.resource.data.impresso == false
                    && request.resource.data.itens is list
                    && request.resource.data.itens.size() > 0
                    && request.resource.data.itens.size() <= 50
                    && request.resource.data.cliente.nome is string
                    && request.resource.data.total is number
                    && (request.resource.data.get('agendadoPara', null) == null
                        || request.resource.data.agendadoPara is number)
                    && ((request.resource.data.origem == 'site'
                         && request.resource.data.get('estoqueBaixado', false) == false
                         && request.resource.data.pagamento.confirmado == false
                         && request.resource.data.cliente.telefone is string)
                     || (request.auth != null
                         && request.resource.data.origem == 'balcao'
                         && request.resource.data.entrega.tipo == 'balcao'
                         && request.resource.data.pagamento.confirmado == true));

      // Mudar status / confirmar Pix / marcar impresso / entregador: só usuário logado.
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Catálogo (preços, ativo, estoque disponível): a loja lê; só a gestão (logado) altera.
    match /produtos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuração da loja (cortesia de sachês, taxa da maquininha): leitura pública.
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Entradas de compra, ajustes, baixas de venda e estornos: só logado.
    match /movimentos/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
